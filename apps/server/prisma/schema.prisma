// Prisma schema for "Plane and Curves"
// Step 1 deliverable — for review before any application code is written.
//
// Conventions:
// - All primary keys: String @id @default(cuid())
// - Delete behaviour is enforced here via onDelete referential actions
//   so the database, not application code, is the source of truth for cascades.

generator client {
  provider        = "prisma-client-js"
  // driverAdapters lets tests run against in-process PGlite (real Postgres, WASM)
  // without a database server. Production still uses the default connection.
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

enum DriveAclAction {
  GRANT
  UPDATE
  REVOKE
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
}

// ---------------------------------------------------------------------------
// User & auth
// ---------------------------------------------------------------------------

model User {
  id                String   @id @default(cuid())
  googleId          String?  @unique
  email             String?  @unique
  name              String
  avatarUrl         String?
  isGuest           Boolean  @default(false)
  driveConnected    Boolean  @default(false)
  driveRootFolderId String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  workspaces           Workspace[]           @relation("WorkspaceOwner")
  sessions             Session[]
  googleCredentials    GoogleCredential[]
  uploadedDocuments    Document[]            @relation("UploadedDocuments")
  workspaceMemberships WorkspaceMember[]     @relation("WorkspaceMemberUser")
  invitedMemberships   WorkspaceMember[]     @relation("WorkspaceMemberInviter")
  sentInvitations      WorkspaceInvitation[] @relation("WorkspaceInvitationInviter")
  workspaceAuditLogs   WorkspaceAuditLog[]   @relation("WorkspaceAuditActor")
}

// A GoogleCredential represents a DRIVE CONNECTION, not a general Google login.
// A row exists ONLY after the user has completed incremental drive.file
// authorization. Users authenticated for identity only (OpenID sign-in, which
// uses access_type=online and returns no refresh token) will NOT have a row.
//
// Deleting a User cascades to their credentials (and by extension revokes them
// in application logic before the row is removed).
model GoogleCredential {
  id                    String    @id @default(cuid())
  // One Drive connection per user → upsert by userId is idempotent (reconnecting
  // updates the row, never creates a duplicate).
  userId                String    @unique
  encryptedRefreshToken String
  scopes                String[]
  connectedAt           DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt             DateTime? @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Workspace & contents
// ---------------------------------------------------------------------------

// Deleting a Workspace cascades to its Boards, Tasks and Document *records*.
// It never touches actual files/folders in the user's Google Drive — that is
// enforced in application logic; driveFolderId is only metadata.
model Workspace {
  id            String   @id @default(cuid())
  userId        String
  name          String
  driveFolderId String?
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)

  user         User                  @relation("WorkspaceOwner", fields: [userId], references: [id], onDelete: Cascade)
  boards       Board[]
  tasks        Task[]
  documents    Document[]
  members      WorkspaceMember[]
  invitations  WorkspaceInvitation[]
  auditLogs    WorkspaceAuditLog[]
  driveAclJobs DriveAclSyncJob[]

  @@index([userId])
}

model Board {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  // DELIBERATE: `@db.Json` (text `json`), NOT the Prisma default `jsonb`.
  //
  // The scene is treated as an opaque Excalidraw *document*, not queryable app
  // data. `json` preserves the exact textual representation (key order, no
  // normalisation), so scenes round-trip byte-for-byte and stay forward-
  // compatible with future Excalidraw versions. `jsonb` reorders keys and
  // normalises — a smoke test caught it breaking the round-trip.
  //
  // TRADE-OFF: `jsonb` would be preferable IF we needed to index or query INTO
  // the scene. We never do (store/return the whole blob only). Do NOT "optimise"
  // this to jsonb without revisiting that invariant — you'd reintroduce the
  // normalisation this exists to avoid.
  elements    Json     @db.Json // Excalidraw elements — persisted exactly as received
  appState    Json     @db.Json // Excalidraw appState — persisted exactly as received
  // Excalidraw image binaries (data URLs), keyed by fileId. Images live here, not
  // in `elements` (which only reference a fileId) — without this they render as
  // broken placeholders after reload. Nullable so existing rows migrate cleanly.
  files       Json?    @db.Json
  revision    Int      @default(0)
  // Slide order within the workspace (float ordering, like Task.order): insert =
  // average of neighbours; rebalance to multiples of 1000 when the gap is tiny.
  order       Float    @default(0)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Back-link only; deleting a Board sets Task.sourceBoardId to null (below).
  sourcedTasks Task[]    @relation("TaskSourceBoard")

  @@index([workspaceId])
  @@index([workspaceId, order])
}

model WorkspaceMember {
  id                String        @id @default(cuid())
  workspaceId       String
  userId            String
  role              WorkspaceRole
  invitedById       String?
  drivePermissionId String?
  aclSyncStatus     OutboxStatus?
  aclSyncError      String?
  joinedAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(3)

  workspace    Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user         User              @relation("WorkspaceMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?             @relation("WorkspaceMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  driveAclJobs DriveAclSyncJob[]

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, role])
}

model WorkspaceInvitation {
  id              String        @id @default(cuid())
  workspaceId     String
  emailNormalized String
  role            WorkspaceRole
  tokenHash       String        @unique
  invitedById     String
  expiresAt       DateTime      @db.Timestamptz(3)
  acceptedAt      DateTime?     @db.Timestamptz(3)
  revokedAt       DateTime?     @db.Timestamptz(3)
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("WorkspaceInvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([emailNormalized])
  @@index([expiresAt])
}

model WorkspaceAuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorUserId String?
  action      String
  metadata    Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation("WorkspaceAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model DriveAclSyncJob {
  id              String         @id @default(cuid())
  workspaceId     String
  memberId        String?
  action          DriveAclAction
  status          OutboxStatus   @default(PENDING)
  emailNormalized String
  desiredRole     WorkspaceRole?
  permissionId    String?
  attempts        Int            @default(0)
  nextAttemptAt   DateTime       @default(now()) @db.Timestamptz(3)
  lastError       String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  member    WorkspaceMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([workspaceId])
}

model Task {
  id              String    @id @default(cuid())
  workspaceId     String
  title           String
  description     String?
  completed       Boolean   @default(false)
  // Timestamptz throughout: instants are stored as UTC unambiguously; the UI
  // converts to the viewer's local timezone.
  completedAt     DateTime? @db.Timestamptz(3)
  order           Float // float ordering: insert between = average neighbours; rebalance below 0.0001 gap
  dueAt           DateTime? @db.Timestamptz(3) // a DUE date/time — labelled "Due" in the UI
  sourceBoardId   String?
  sourceElementId String?
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Deleting a Board must NOT delete tasks — just clear the back-link.
  sourceBoard Board?     @relation("TaskSourceBoard", fields: [sourceBoardId], references: [id], onDelete: SetNull)
  documents   Document[]

  @@index([workspaceId])
  @@index([sourceBoardId])
}

// No file bytes are ever stored here — only a reference to the file in Drive.
model Document {
  id           String   @id @default(cuid())
  workspaceId  String
  taskId       String?
  driveFileId  String
  name         String
  mimeType     String
  sizeBytes    Int // capped at 100 MB by upload validation; well within Int range
  webViewLink  String
  iconLink     String?
  uploadedById String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Deleting a Task must NOT delete its documents — just detach them.
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedBy User      @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taskId])
  @@index([uploadedById])
}
