{
  "name": "@plane-and-curves/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:deploy": "prisma migrate deploy",
    "smoke:schema": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/smoke-schema.sql",
    "smoke:auth": "npm run smoke:schema && tsx scripts/smoke-auth.ts",
    "smoke:workspaces": "npm run smoke:schema && tsx scripts/smoke-workspaces.ts",
    "smoke:boards": "npm run smoke:schema && tsx scripts/smoke-boards.ts",
    "smoke:tasks": "npm run smoke:schema && tsx scripts/smoke-tasks.ts",
    "smoke:documents": "npm run smoke:schema && tsx scripts/smoke-documents.ts",
    "smoke:qa": "npm run smoke:schema && tsx scripts/smoke-qa.ts",
    "smoke:bridge": "npm run smoke:schema && tsx scripts/smoke-bridge.ts",
    "smoke": "npm run smoke:auth && npm run smoke:workspaces && npm run smoke:boards && npm run smoke:tasks && npm run smoke:documents && npm run smoke:bridge && npm run smoke:qa"
  },
  "dependencies": {
    "@plane-and-curves/shared": "*",
    "@prisma/client": "^5.18.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "pglite-prisma-adapter": "^0.3.0",
    "pino-pretty": "^11.2.2",
    "prisma": "^5.18.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
