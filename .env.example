# =============================================================================
# Plane and Curves — environment configuration
# Copy to .env and fill in real values. Never commit .env. Never hardcode these.
# =============================================================================

# ---- Server ----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Base URL of the API server (used to build OAuth redirect URIs).
SERVER_URL=http://localhost:4000
# Base URL of the web frontend (used for CORS and post-login redirects).
WEB_URL=http://localhost:5173

# ---- Database (PostgreSQL) --------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plane_and_curves?schema=public

# ---- Sessions ---------------------------------------------------------------
# Name of the httpOnly session cookie. Sessions last 30 days (set in code).
SESSION_COOKIE_NAME=pac_session
# "true" only over HTTPS. Keep false for local http development.
SESSION_COOKIE_SECURE=false

# ---- Google OAuth (Sign-In) -------------------------------------------------
# From Google Cloud Console > Credentials > OAuth 2.0 Client ID (Web app).
# Sign-in requests ONLY: openid, email, profile. No Drive scope here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered as an Authorized redirect URI in Google Cloud Console.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/auth/google/callback

# ---- Google Drive (incremental consent) -------------------------------------
# Separate redirect URI for the drive.file consent step (requested only when the
# user chooses Connect in Documents). ONLY the drive.file scope is ever used.
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:4000/auth/google/drive/callback

# ---- Encryption -------------------------------------------------------------
# 32-byte key for AES-256-GCM, hex-encoded (64 hex chars).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
